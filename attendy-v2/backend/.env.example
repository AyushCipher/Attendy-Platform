# Copy to .env and adjust. All of these have working local-dev defaults baked into
# app/core/config.py, so a fresh clone can run without a .env at all -- this file is
# for documenting what's overridable, notably before a real deployment.

DATABASE_URL=postgresql+asyncpg://attendy:attendy_dev@localhost:5455/attendy

JWT_SECRET=change-me-to-a-real-random-32+-byte-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=["http://localhost:5173"]

FACE_MATCH_THRESHOLD=0.38
FACE_MODEL_PACK=buffalo_l

ENVIRONMENT=development
